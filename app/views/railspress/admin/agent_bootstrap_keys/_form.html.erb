<%= form_with model: [:admin, agent_bootstrap_key], class: "rp-form rp-form--narrow" do |form| %>
  <%= rp_form_errors(agent_bootstrap_key) %>

  <%= rp_hint("An Agent Setup Key is a one-time onboarding credential. It cannot publish content, expires after 1 hour by default, and is exchanged for a securely stored API key.") %>

  <%= rp_string_field(
        form,
        :name,
        primary: true,
        required: true,
        label: "Agent Setup Key Name",
        placeholder: "e.g., Claude Code",
        hint: "Use a descriptive name so you can identify this setup key later."
      ) %>

  <%= rp_datetime_field(
        form,
        :expires_at,
        label: "Expiration",
        hint: "Defaults to 1 hour from now. Set a custom date/time to override.",
        step: 60
      ) %>

  <%= rp_form_actions(form, admin_api_keys_path, submit_text: "Create Agent Setup Key") %>
<% end %>
