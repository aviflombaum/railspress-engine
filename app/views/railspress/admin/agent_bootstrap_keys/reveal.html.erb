<% content_for :title, "Agent Setup Key Created" %>

<h1 class="rp-page-title rp-page-title--standalone">Agent Setup Key Created</h1>

<div class="rp-card rp-card--padded">
  <div class="rp-form rp-form--spacious">
    <p class="rp-hint">
      Copy this Agent Setup Key now. It expires shortly, can be used only once, and will not be shown again.
    </p>

    <%= render "railspress/admin/shared/copyable_textarea",
        id: "rp-bootstrap-key-token",
        label: "Agent Setup Key",
        value: @plain_bootstrap_token,
        rows: 4,
        hint: "RailsPress Agent exchanges this once for an API key. This key cannot publish content.",
        button_text: "Copy Agent Setup Key" %>

    <%= render "railspress/admin/shared/copyable_textarea",
        id: "rp-agent-manifest",
        label: "Project Connection File (Token-Free)",
        value: @railspress_manifest,
        rows: 12,
        button_text: "Copy RAILSPRESS.md" %>

    <%= render "railspress/admin/shared/copyable_textarea",
        id: "rp-bootstrap-quick-start",
        label: "Connect Project",
        value: @bootstrap_quick_start,
        rows: 6,
        button_text: "Copy Quick Start" %>

    <%= render "railspress/admin/shared/copyable_textarea",
        id: "rp-bootstrap-instructions",
        label: "Agent Setup Instructions",
        value: @bootstrap_instructions,
        rows: 15,
        button_text: "Copy Instructions" %>

    <div class="rp-form-actions">
      <%= link_to "Create Another Agent Setup Key", new_admin_agent_bootstrap_key_path, class: "rp-btn rp-btn--primary" %>
      <%= link_to "Back to Agents & API", admin_api_keys_path, class: "rp-btn rp-btn--secondary" %>
    </div>
  </div>
</div>
