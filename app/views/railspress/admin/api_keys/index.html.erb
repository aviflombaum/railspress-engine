<% content_for :title, "Agents & API" %>

<%= rp_page_header "Agents & API",
    "New Agent Setup Key" => [new_admin_agent_bootstrap_key_path, class: "rp-btn rp-btn--secondary"],
    "New Developer API Key" => new_admin_api_key_path %>

<div class="rp-card rp-card--padded rp-card--section">
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">1. Install RailsPress Agent</h2>
    </div>

    <div class="rp-form rp-form--spacious">
      <p class="rp-hint">Installs the RailsPress CLI and the RailsPress skill for Codex and Claude when detected. The installer checks system requirements automatically.</p>

      <%= render "railspress/admin/shared/copyable_textarea",
          id: "rp-agent-install",
          label: "Install",
          value: @railspress_agent_install,
          rows: 2,
          button_text: "Copy Install Command" %>

      <p class="rp-hint">The CLI manages setup, trust, credentials, and capability checks. The installed skill teaches your coding agent how to publish through the RailsPress API.</p>
    </div>
  </div>
</div>

<div class="rp-card rp-card--padded rp-card--section">
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">2. Connect This Publishing Project</h2>
    </div>

    <div class="rp-form rp-form--spacious">
      <p class="rp-hint"><code>RAILSPRESS.md</code> tells your coding agent which RailsPress site this project publishes to. It contains no credentials and is safe to commit. Save it in the root of the project whose content the agent will publish, which may be different from the Rails application hosting RailsPress.</p>

      <%= render "railspress/admin/shared/copyable_textarea",
          id: "rp-agent-manifest",
          label: "Project Connection File (Token-Free)",
          value: @railspress_manifest,
          rows: 12,
          button_text: "Copy RAILSPRESS.md" %>

      <p class="rp-hint">Next, create an Agent Setup Key. It expires in one hour, cannot publish content itself, and is exchanged once for an API key stored outside the repository.</p>

      <div class="rp-form-actions">
        <%= link_to "Create Agent Setup Key", new_admin_agent_bootstrap_key_path, class: "rp-btn rp-btn--primary" %>
      </div>

      <details>
        <summary>Manual agent setup without the RailsPress CLI</summary>
        <p class="rp-hint">Use this advanced fallback only when the CLI cannot be installed. Your coding agent must perform trust review, one-time exchange, secure storage, and API capability discovery itself.</p>
        <%= render "railspress/admin/shared/copyable_textarea",
            id: "rp-manual-agent-instructions",
            label: "Manual Agent Instructions",
            value: @manual_agent_instructions,
            rows: 16,
            button_text: "Copy Manual Instructions" %>
      </details>
    </div>
  </div>
</div>

<div class="rp-card rp-card--padded rp-card--section">
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">Developer API Keys</h2>
    </div>

    <p class="rp-hint">Reusable credentials for custom scripts, CI, and clients that call the HTTP API directly. For first-time Codex or Claude setup, use an Agent Setup Key instead.</p>

    <% if @api_keys.any? %>
      <div class="rp-table--responsive">
        <table class="rp-table">
          <thead>
            <tr>
              <th><%= rp_table_header("Name") %></th>
              <th><%= rp_table_header("Prefix") %></th>
              <th><%= rp_table_header("Status") %></th>
              <th><%= rp_table_header("Last Used") %></th>
              <th><%= rp_table_header("Expires") %></th>
              <th class="rp-table-actions"><%= rp_table_header("Actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @api_keys.each do |api_key| %>
              <% api_status_type = case api_key.status
                  when "active" then :published
                  when "expired" then :draft
                  else :failed
                  end %>
              <tr>
                <td class="rp-table-primary"><%= api_key.name %></td>
                <td class="rp-table-secondary"><code><%= api_key.token_prefix %></code></td>
                <td><%= rp_status_badge(api_key.status, type: api_status_type) %></td>
                <td><%= api_key.last_used_at ? l(api_key.last_used_at, format: :short) : "Never" %></td>
                <td><%= api_key.expires_at ? l(api_key.expires_at, format: :short) : "Never" %></td>
                <td class="rp-table-actions">
                  <%= button_to "Rotate",
                      rotate_admin_api_key_path(api_key),
                      method: :post,
                      class: "rp-btn rp-btn--secondary rp-btn--sm" %>
                  <% unless api_key.revoked_at %>
                    <%= button_to "Revoke",
                        revoke_admin_api_key_path(api_key),
                        method: :post,
                        class: "rp-btn rp-btn--danger rp-btn--sm",
                        data: { turbo_confirm: "Revoke this API key?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= rp_empty_state("No API keys yet.", link_text: "Create your first API key", link_path: new_admin_api_key_path) %>
    <% end %>
  </div>
</div>

<div class="rp-card rp-card--padded rp-card--section">
  <div class="rp-section">
    <div class="rp-section-header">
      <h2 class="rp-section-title">Agent Setup Keys</h2>
    </div>

    <% if @agent_bootstrap_keys.any? %>
      <div class="rp-table--responsive">
        <table class="rp-table">
          <thead>
            <tr>
              <th><%= rp_table_header("Name") %></th>
              <th><%= rp_table_header("Prefix") %></th>
              <th><%= rp_table_header("Status") %></th>
              <th><%= rp_table_header("Used") %></th>
              <th><%= rp_table_header("Expires") %></th>
              <th class="rp-table-actions"><%= rp_table_header("Actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @agent_bootstrap_keys.each do |bootstrap_key| %>
              <% bootstrap_status_type = case bootstrap_key.status
                  when "active" then :published
                  when "used" then :completed
                  when "expired" then :draft
                  else :failed
                  end %>
              <tr>
                <td class="rp-table-primary"><%= bootstrap_key.name %></td>
                <td class="rp-table-secondary"><code><%= bootstrap_key.token_prefix %></code></td>
                <td><%= rp_status_badge(bootstrap_key.status, type: bootstrap_status_type) %></td>
                <td><%= bootstrap_key.used_at ? l(bootstrap_key.used_at, format: :short) : "No" %></td>
                <td><%= l(bootstrap_key.expires_at, format: :short) %></td>
                <td class="rp-table-actions">
                  <% if bootstrap_key.active? %>
                    <%= button_to "Revoke",
                        revoke_admin_agent_bootstrap_key_path(bootstrap_key),
                        method: :post,
                        class: "rp-btn rp-btn--danger rp-btn--sm",
                        data: { turbo_confirm: "Revoke this bootstrap key?" } %>
                  <% else %>
                    <span class="rp-hint">No actions</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= rp_empty_state("No bootstrap keys yet.", link_text: "Create your first bootstrap key", link_path: new_admin_agent_bootstrap_key_path) %>
    <% end %>
  </div>
</div>
